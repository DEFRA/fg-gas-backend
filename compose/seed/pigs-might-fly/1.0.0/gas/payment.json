{
  "code": "pigs-might-fly",
  "sbi": "$.agreement.identifiers.sbi",
  "frn": "$.agreement.identifiers.frn",
  "originalInvoiceNumber": "",
  "scheme": "SFI",
  "sourceSystem": "FPTT",
  "deliveryBody": "RP00",
  "fesCode": "FALS_FPTT",
  "ledger": "AP",
