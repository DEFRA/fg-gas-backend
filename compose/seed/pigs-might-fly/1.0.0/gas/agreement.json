{
  "code": "pigs-might-fly",
  "agreementNumberPrefix": "PMF",
  "processDefinitions": {
    "GENERATE_OFFER": {
      "type": "endpoint",
      "endpoint": {
        "method": "POST",
        "path": "/paymentSchedule",
        "service": "GRANT_FUNDING_CALCULATOR"
      },
      "request": {
        "body": {
          "agreementStartDate": "$.execution.executedAt",
          "pigTypes": [
            {
              "pigType": "largeWhite",
              "quantity": "jsonata:$.application.whitePigsCount ?? 0"
            },
            {
              "pigType": "britishLandrace",
              "quantity": "jsonata:$.application.britishLandracePigsCount ?? 0"
            },
            {
              "pigType": "berkshire",
              "quantity": "jsonata:$.application.berkshirePigsCount ?? 0"
            },
            {
              "pigType": "other",
              "quantity": "jsonata:$.application.otherPigsCount ?? 0"
            }
          ]
        }
      },
      "output": {
        "startDate": "$.response.payment.agreementStartDate",
        "endDate": "$.response.payment.agreementEndDate",
        "actions": {
          "itemsRef": "jsonata:$.response.payment.payments[0].invoiceLines[quantity > 0]",
          "items": {
            "ref": "@.pigType",
            "code": "@.pigType",
            "description": "@.description",
            "quantity": "@.quantity",
            "unit": "head",
            "ratePence": "@.unitPricePence",
            "totalAmountPence": "@.amountPence"
          }
        },
        "items": [],
        "totalAmountPence": "$.response.payment.agreementTotalPence",
        "paymentSchedule": {
          "instalments": {
            "itemsRef": "$.response.payment.payments",
            "items": {
              "dueDate": "@.dueDate",
              "totalAmountPence": "@.totalAmountPence",
              "lineItems": {
                "itemsRef": "@.invoiceLines",
                "items": {
                  "actionRef": "@.pigType",
                  "amountPence": "@.amountPence"
                }
              }
            }
          }
        }
      }
    },
    "CREATE_AGREEMENT_PAYMENT": {
      "type": "handler"
    }
  },
  "create": {
    "target": "offered",
    "application": "$.input.answers",
    "processes": ["GENERATE_OFFER"]
  },
  "states": {
    "offered": {
      "page": "offered",
      "on": {
        "accept": {
          "target": "accepted",
          "page": "accept",
          "validation": {
            "required": [
              {
                "name": "confirm",
                "value": "confirmed",
                "href": "#confirm",
                "message": "Confirm this agreement offer before accepting it"
              }
            ]
          },
          "processes": ["CREATE_AGREEMENT_PAYMENT"]
        },
        "withdraw": {
          "target": "withdrawn"
        },
        "cancel": {
          "target": "cancelled"
        }
      }
    },
    "accepted": {
      "page": "accepted",
      "on": {
        "terminate": {
          "target": "terminated"
        }
      }
    },
    "withdrawn": {
      "page": "withdrawn"
    },
    "cancelled": {
      "page": "cancelled"
    },
    "terminated": {
      "page": "terminated"
    }
  },
  "pages": {
    "document": {
      "title": "Pigs Might Fly agreement document",
      "layout": "document",
      "contents": true,
      "print": true,
      "watermarks": {
        "offered": "DRAFT",
        "withdrawn": "WITHDRAWN",
        "cancelled": "CANCELLED",
        "terminated": "TERMINATED"
      },
      "components": [
        {
          "component": "grid-row",
          "components": [
            {
              "component": "grid-column",
              "width": "two-thirds",
              "components": [
                {
                  "component": "notification-banner",
                  "condition": "jsonata:$.agreement.state = 'offered'",
                  "title": "This is a draft version of your agreement"
                },
                {
                  "component": "notification-banner",
                  "condition": "jsonata:$.agreement.state = 'withdrawn'",
                  "title": "This agreement offer has been withdrawn"
                },
                {
                  "component": "notification-banner",
                  "condition": "jsonata:$.agreement.state = 'cancelled'",
                  "title": "This agreement offer has been cancelled"
                },
                {
                  "component": "notification-banner",
                  "condition": "jsonata:$.agreement.state = 'terminated'",
                  "title": "This agreement has been terminated"
                },
                {
                  "component": "heading",
                  "level": 1,
                  "text": "Pigs Might Fly agreement document"
                },
                {
                  "component": "summary-list",
                  "rows": [
                    {
                      "label": "SBI",
                      "text": "$.agreement.identifiers.sbi"
                    },
                    {
                      "label": "Agreement number",
                      "text": "$.agreement.agreementNumber"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "sections": [
        {
          "id": "agreement-overview",
          "title": "Agreement overview",
          "components": [
            {
              "component": "grid-row",
              "components": [
                {
                  "component": "grid-column",
                  "width": "two-thirds",
                  "components": [
                    {
                      "component": "paragraph",
                      "text": "This test agreement records the pigs included in your offer, the funding amount and, after acceptance, the payment schedule."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "pigs-and-funding",
          "title": "Pigs and funding",
          "components": [
            {
              "component": "grid-row",
              "components": [
                {
                  "component": "grid-column",
                  "width": "two-thirds",
                  "components": [
                    {
                      "component": "table",
                      "head": [
                        {
                          "text": "Pig type"
                        },
                        {
                          "text": "Number of pigs"
                        },
                        {
                          "text": "Funding amount"
                        }
                      ],
                      "rowsRef": "$.agreement.actions",
                      "rows": [
                        {
                          "text": "@.description"
                        },
                        {
                          "text": "@.quantity"
                        },
                        {
                          "text": "@.totalAmountPence",
                          "format": "poundsFromPence"
                        }
                      ]
                    },
                    {
                      "component": "summary-list",
                      "rows": [
                        {
                          "label": "Total funding",
                          "text": "$.agreement.totalAmountPence",
                          "format": "poundsFromPence"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "payment-schedule",
          "title": "Payment schedule",
          "components": [
            {
              "component": "grid-row",
              "components": [
                {
                  "component": "grid-column",
                  "width": "two-thirds",
                  "components": [
                    {
                      "component": "summary-list",
                      "rows": [
                        {
                          "label": "Agreement start date",
                          "text": "$.agreement.startDate",
                          "format": "dateLong"
                        },
                        {
                          "label": "Agreement end date",
                          "text": "$.agreement.endDate",
                          "format": "dateLong"
                        },
                        {
                          "label": "Total payment",
                          "text": "$.agreement.totalAmountPence",
                          "format": "poundsFromPence"
                        }
                      ]
                    },
                    {
                      "component": "table",
                      "head": [
                        {
                          "text": "Payment date"
                        },
                        {
                          "text": "Amount"
                        }
                      ],
                      "rowsRef": "$.agreement.paymentSchedule.instalments",
                      "rows": [
                        {
                          "text": "@.dueDate",
                          "format": "dateLong"
                        },
                        {
                          "text": "@.totalAmountPence",
                          "format": "poundsFromPence"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "acceptance",
          "title": "Acceptance",
          "condition": "jsonata:$.agreement.state = 'accepted'",
          "components": [
            {
              "component": "grid-row",
              "components": [
                {
                  "component": "grid-column",
                  "width": "two-thirds",
                  "components": [
                    {
                      "component": "summary-list",
                      "rows": [
                        {
                          "label": "Accepted on",
                          "text": "$.agreement.acceptedAt",
                          "format": "dateLong"
                        }
                      ]
                    },
                    {
                      "component": "paragraph",
                      "text": "This agreement was accepted electronically."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "about-this-test-agreement",
          "title": "About this test agreement",
          "components": [
            {
              "component": "grid-row",
              "components": [
                {
                  "component": "grid-column",
                  "width": "two-thirds",
                  "components": [
                    {
                      "component": "paragraph",
                      "text": "Pigs Might Fly is a test grant used to check the agreement service. It is not a real grant agreement."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "offered": {
      "title": "Review your agreement offer",
      "components": [
        {
          "component": "grid-row",
          "components": [
            {
              "component": "grid-column",
              "width": "two-thirds",
              "components": [
                {
                  "component": "heading",
                  "level": 1,
                  "text": "Review your agreement offer"
                },
                {
                  "component": "paragraph",
                  "text": "Check the details of this test agreement before you continue."
                },
                {
                  "component": "summary-list",
                  "rows": [
                    {
                      "label": "SBI",
                      "text": "$.agreement.identifiers.sbi"
                    },
                    {
                      "label": "Agreement number",
                      "text": "$.agreement.agreementNumber"
                    }
                  ]
                },
                {
                  "component": "heading",
                  "level": 2,
                  "text": "Pigs and funding"
                },
                {
                  "component": "table",
                  "head": [
                    {
                      "text": "Pig type"
                    },
                    {
                      "text": "Number of pigs"
                    },
                    {
                      "text": "Funding amount"
                    }
                  ],
                  "rowsRef": "$.agreement.actions",
                  "rows": [
                    {
                      "text": "@.description"
                    },
                    {
                      "text": "@.quantity"
                    },
                    {
                      "text": "@.totalAmountPence",
                      "format": "poundsFromPence"
                    }
                  ]
                },
                {
                  "component": "summary-list",
                  "rows": [
                    {
                      "label": "Agreement start date",
                      "text": "$.agreement.startDate",
                      "format": "dateLong"
                    },
                    {
                      "label": "Agreement end date",
                      "text": "$.agreement.endDate",
                      "format": "dateLong"
                    },
                    {
                      "label": "Total funding",
                      "text": "$.agreement.totalAmountPence",
                      "format": "poundsFromPence"
                    }
                  ]
                },
                {
                  "component": "url",
                  "href": {
                    "urlTemplate": "/agreements/{agreementNumber}/document",
                    "params": {
                      "agreementNumber": "$.agreement.agreementNumber"
                    }
                  },
                  "text": "View the draft agreement (opens in new tab)",
                  "target": "_blank",
                  "classes": "govuk-link govuk-!-display-block govuk-!-margin-bottom-4"
                },
                {
                  "component": "button",
                  "action": "accept",
                  "text": "Continue"
                }
              ]
            }
          ]
        }
      ]
    },
    "accept": {
      "title": "Accept your agreement offer",
      "components": [
        {
          "component": "grid-row",
          "components": [
            {
              "component": "grid-column",
              "width": "two-thirds",
              "components": [
                {
                  "component": "form",
                  "components": [
                    {
                      "component": "heading",
                      "level": 1,
                      "text": "Accept your agreement offer"
                    },
                    {
                      "component": "url",
                      "href": {
                        "urlTemplate": "/agreements/{agreementNumber}/document",
                        "params": {
                          "agreementNumber": "$.agreement.agreementNumber"
                        }
                      },
                      "text": "View the draft agreement (opens in new tab)",
                      "target": "_blank",
                      "classes": "govuk-link govuk-!-display-block govuk-!-margin-bottom-4"
                    },
                    {
                      "component": "paragraph",
                      "text": "By accepting this offer, you confirm that:"
                    },
                    {
                      "component": "unordered-list",
                      "items": [
                        {
                          "text": "the information in the agreement is correct"
                        },
                        {
                          "text": "you have authority to accept the agreement"
                        },
                        {
                          "text": "you understand this is a test grant"
                        }
                      ]
                    },
                    {
                      "component": "checkboxes",
                      "name": "confirm",
                      "items": [
                        {
                          "value": "confirmed",
                          "text": "I confirm I have read the information in this section and accept this agreement offer."
                        }
                      ]
                    },
                    {
                      "component": "button",
                      "text": "Accept agreement offer"
                    }
                  ],
                  "action": "accept"
                }
              ]
            }
          ]
        }
      ],
      "backLink": {
        "text": "Back",
        "href": {
          "urlTemplate": "/agreements/{agreementNumber}",
          "params": {
            "agreementNumber": "$.agreement.agreementNumber"
          }
        }
      }
    },
    "withdrawn": {
      "title": "Your agreement offer has been withdrawn",
      "watermarks": {
        "withdrawn": "WITHDRAWN"
      },
      "components": [
        {
          "component": "grid-row",
          "components": [
            {
              "component": "grid-column",
              "width": "two-thirds",
              "components": [
                {
                  "component": "notification-banner",
                  "title": "This agreement offer has been withdrawn",
                  "text": "The Rural Payments Agency has withdrawn this offer. You do not need to do anything."
                },
                {
                  "component": "summary-list",
                  "rows": [
                    {
                      "label": "Agreement number",
                      "text": "$.agreement.agreementNumber"
                    }
                  ]
                },
                {
                  "component": "url",
                  "href": {
                    "urlTemplate": "/agreements/{agreementNumber}/document",
                    "params": {
                      "agreementNumber": "$.agreement.agreementNumber"
                    }
                  },
                  "text": "View and print your withdrawn agreement (opens in new tab)",
                  "target": "_blank"
                }
              ]
            }
          ]
        }
      ]
    },
    "cancelled": {
      "title": "Your agreement offer has been cancelled",
      "watermarks": {
        "cancelled": "CANCELLED"
      },
      "components": [
        {
          "component": "grid-row",
          "components": [
            {
              "component": "grid-column",
              "width": "two-thirds",
              "components": [
                {
                  "component": "notification-banner",
                  "title": "This agreement offer has been cancelled",
                  "text": "Your funding offer is currently being updated. The Rural Payments Agency will email you when it is ready for you to review."
                },
                {
                  "component": "summary-list",
                  "rows": [
                    {
                      "label": "Agreement number",
                      "text": "$.agreement.agreementNumber"
                    }
                  ]
                },
                {
                  "component": "url",
                  "href": {
                    "urlTemplate": "/agreements/{agreementNumber}/document",
                    "params": {
                      "agreementNumber": "$.agreement.agreementNumber"
                    }
                  },
                  "text": "View and print your cancelled agreement (opens in new tab)",
                  "target": "_blank"
                }
              ]
            }
          ]
        }
      ]
    },
    "terminated": {
      "title": "Your agreement has been terminated",
      "watermarks": {
        "terminated": "TERMINATED"
      },
      "components": [
        {
          "component": "grid-row",
          "components": [
            {
              "component": "grid-column",
              "width": "two-thirds",
              "components": [
                {
                  "component": "notification-banner",
                  "title": "This agreement has been terminated",
                  "text": "The Rural Payments Agency has terminated this agreement. All actions and standards in the agreement have ended."
                },
                {
                  "component": "summary-list",
                  "rows": [
                    {
                      "label": "Agreement number",
                      "text": "$.agreement.agreementNumber"
                    },
                    {
                      "label": "Agreement start date",
                      "text": "$.agreement.startDate",
                      "format": "dateLong"
                    }
                  ]
                },
                {
                  "component": "url",
                  "href": {
                    "urlTemplate": "/agreements/{agreementNumber}/document",
                    "params": {
                      "agreementNumber": "$.agreement.agreementNumber"
                    }
                  },
                  "text": "View and print your terminated agreement (opens in new tab)",
                  "target": "_blank"
                }
              ]
            }
          ]
        }
      ]
    },
    "accepted": {
      "title": "Your agreement is now active",
      "components": [
        {
          "component": "grid-row",
          "components": [
            {
              "component": "grid-column",
              "width": "two-thirds",
              "components": [
                {
                  "component": "panel",
                  "title": "Agreement offer accepted",
                  "text": "Agreement number: $.agreement.agreementNumber"
                },
                {
                  "component": "summary-list",
                  "rows": [
                    {
                      "label": "Agreement start date",
                      "text": "$.agreement.startDate",
                      "format": "dateLong"
                    }
                  ]
                },
                {
                  "component": "url",
                  "href": {
                    "urlTemplate": "/agreements/{agreementNumber}/document",
                    "params": {
                      "agreementNumber": "$.agreement.agreementNumber"
                    }
                  },
                  "text": "View and print your agreement (opens in new tab)",
                  "target": "_blank"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
