NODE_ENV=development

SERVICE_NAME=fg-gas-backend
SERVICE_VERSION=0.0.0

PORT=3102

LOG_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=pino-pretty

TRACING_HEADER=x-cdp-request-id

MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DATABASE=fg-gas-backend

AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://floci:4566

OUTBOX_MAX_RETRIES=5
OUTBOX_CLAIM_MAX_RECORDS=2
OUTBOX_EXPIRES_MS=5000
OUTBOX_POLL_MS=250
INBOX_MAX_RETRIES=5
INBOX_CLAIM_MAX_RECORDS=2
INBOX_EXPIRES_MS=5000
INBOX_POLL_MS=250
FIFO_LOCK_TTL_MS=5000

ENVIRONMENT=local
VIEW_AGREEMENT_URI=http://localhost:3000

GAS__SNS__AUDIT_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:gas__sns__audit_topic_arn
GAS__SNS__CREATE_AGREEMENT_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:gas__sns__create_agreement_fifo.fifo
# Comma-separated grant codes whose Agreements are owned by GAS
GAS_MANAGED_AGREEMENT_GRANT_CODES=pigs-might-fly

GAS__SNS__GRANT_APPLICATION_CREATED_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:gas__sns__grant_application_created_fifo.fifo
GAS__SNS__GRANT_APPLICATION_STATUS_UPDATED_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:gas__sns__application_status_updated_fifo.fifo
GAS__SNS__CREATE_NEW_CASE_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:gas__sns__create_new_case_fifo.fifo
GAS__SNS__UPDATE_CASE_STATUS_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:gas__sns__update_case_status_fifo.fifo
GAS__SNS__UPDATE_AGREEMENT_STATUS_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:gas__sns__update_agreement_status_fifo.fifo
GAS__SNS__AGREEMENT_STATUS_UPDATED_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:agreement_status_updated_fifo.fifo
GAS__SNS__CREATE_PAYMENT_TOPIC_ARN=arn:aws:sns:eu-west-2:000000000000:gas__sns__create_payment_fifo.fifo
GAS__SQS__UPDATE_STATUS_QUEUE_URL=http://sqs.eu-west-2.localhost:4566/000000000000/gas__sqs__update_status_fifo.fifo
GAS__SQS__UPDATE_AGREEMENT_STATUS_QUEUE_URL=http://sqs.eu-west-2.localhost:4566/000000000000/gas__sqs__update_agreement_status_fifo.fifo
GAS__SQS__CONFIG_VERSION_QUEUE_URL=http://sqs.eu-west-2.localhost:4566/000000000000/gas__sqs__config_version_updated

CONFIG_BROKER_S3_BUCKET=config-broker-local

# Caseworking backend (fg-cw-backend). CW_BACKEND_URL is the base URL (no
# trailing slash); CW_BACKEND_TOKEN is the service access token GAS presents
# as a bearer token when calling it, supplied per environment from the
# platform secret store (never commit a real token). Both optional - leave
# unset if not calling fg-cw-backend locally; otherwise point the URL at
# wherever fg-cw-backend is running.
# CW_BACKEND_URL=http://localhost:3002
# CW_BACKEND_TOKEN=replace-with-service-token

# A single service access token to seed on boot, as a client:sha256hex pair.
# GAS writes the matching access_tokens record itself, so this is the only step
# needed to issue a credential - see "Service to service authentication".
# Generate a pair with:
#   npm run token:new -- <client-name>
# SERVICE_ACCESS_TOKEN_HASH=

# Agreement definitions' "endpoints" (e.g. pmf.js's "calculate-funding") resolve
# a base URL from {service}_URL by convention. GRANT_FUNDING_CALCULATOR is the
# fg-gss-pmf service (sibling repo) - run it locally (npm run dev, default
# port 3001) and point this at it. No fg-grants-core compose wiring for it yet.
# GRANT_FUNDING_CALCULATOR_URL=http://localhost:3001

# Agreement endpoint services can also provide headers using {SERVICE}_HEADERS.
# LAND_GRANTS_URL=http://localhost:3009
# LAND_GRANTS_TOKEN=replace-with-auth-token
# LAND_GRANTS_HEADERS="Authorization: Bearer ${LAND_GRANTS_TOKEN}"

# fg-grants-core: when working with the grants-core docker compose and `npm run dev` set up - uncomment
#  AWS_ENDPOINT_URL=http://localhost:4566
#  OIDC_JWKS_URI=http://localhost:3010/jwks
#  MONGO_URI=mongodb://localhost:27017/?replicaSet=mongoRepl
#  PORT=3102
# end grants-core

# FGP-1307: caller-token verification. AGREEMENTS_JWT_SECRET is the shared HS256
# secret GAS uses to verify the caller token (x-encrypted-auth header) forwarded
# by Agreements UI. It must match the secret the producer services sign with
# (Caseworking frontend, PDF service, Grants UI). Supplied per environment via
# the platform secret store (never commit a real secret). Optional for now while
# verification runs in warn-only mode.
# AGREEMENTS_JWT_SECRET=replace-with-shared-secret
# The producer issuers permitted to mint caller tokens are a fixed code constant
# (grants-ui, fg-cw-frontend, agreements-pdf); there is no env var for them.
#
# FGP-1307: kid-keyed key rotation. AGREEMENTS_JWT_DEFAULT_KID is the logical key
# id the default AGREEMENTS_JWT_SECRET is stored under, and the kid assumed when
# an incoming caller token carries no kid header (e.g. grants-ui). Defaults to
# agreements-hs256-1.
# AGREEMENTS_JWT_DEFAULT_KID=agreements-hs256-1
# AGREEMENTS_JWT_KEYRING is an optional JSON object of additional verification
# secrets keyed by kid, used to verify tokens signed with a rotated key during a
# rotation overlap. Example: {"agreements-hs256-2":"the-next-secret"}.
# AGREEMENTS_JWT_KEYRING={"agreements-hs256-2":"replace-with-next-secret"}
#
# FGP-1307: CALLER_TOKEN_ENFORCE controls the rollout. When true (default), a
# missing/invalid caller token or a claim mismatch rejects the request on the
# agreement routes, and GAS derives caller identity from the verified token
# instead of the unsigned x-agreement-* headers. Set to false to keep warn-only
# behaviour in an environment that is not yet ready to enforce.
# CALLER_TOKEN_ENFORCE=true
